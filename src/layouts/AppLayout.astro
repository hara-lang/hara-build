---
import HaraMark from "@hara-lang/ui-astro/astro/HaraMark.astro";
import ThemeToggle from "@hara-lang/ui-astro/astro/ThemeToggle.astro";
import Shell from "@hara-lang/ui-astro/astro/v2/Shell.astro";
import Header from "@hara-lang/ui-astro/astro/v2/Header.astro";
import ContextNav from "@hara-lang/ui-astro/astro/v2/ContextNav.astro";
import "@hara-lang/ui/v2.css";
import "@hara-lang/ui/motifs.css";
import "../styles/app.css";
import "../styles/shell.css";
import "../styles/v2-adoption.css";

const {
  title = "Hara Build",
  description = "Build with Hara: specifications, APIs, runtimes, packages, and evidence.",
  canonicalPath = Astro.url.pathname
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL("/og-hara-build.jpg", Astro.site);
const activePath = Astro.url.pathname;
const ecosystemNav = [
  { href: "https://play.hara-lang.org/", label: "Play", external: true },
  { href: "https://learn.hara-lang.org/", label: "Learn", external: true },
  { href: "https://build.hara-lang.org/", label: "Build", current: true }
];
const workflowNav = [
  { href: "/", label: "Overview" },
  { href: "/registry", label: "Registry" },
  { href: "/check", label: "Check" },
  { href: "/publish", label: "Publish" },
  { href: "/docs/", label: "Docs" },
  { href: "/developers", label: "API" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="hara-identity-mode" content="popup" />
    <meta name="theme-color" content="#080a0d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hara Build" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="3840" />
    <meta property="og:image:height" content="2016" />
    <meta property="og:image:alt" content="Hara Build — developer tools and executable standards" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Hara Build — developer tools and executable standards" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class="hara-v2 build-product">
    <a class="skip-link" href="#content">Skip to content</a>
    <Shell
      sidebar={false}
      aside={false}
      variant="product"
      mainId="content"
      class="build-v2-shell"
      style="--hara-v2-page: clamp(16px, 2.6vw, 40px);"
    >
      <Header
        slot="header"
        homeHref="https://hara-lang.org/"
        section="Build"
        nav={ecosystemNav}
        activePath={activePath}
        label="Hara Build"
      >
        <div data-hara-identity></div>
        <ThemeToggle label="Theme" />
      </Header>
      <ContextNav
        slot="context"
        items={workflowNav}
        activePath={activePath}
        label="Build workflow navigation"
      />

      <slot />

      <footer slot="footer" class="app-footer">
        <div>
          <HaraMark size={26} title="Hara" />
          <span>Executable standards for the Hara ecosystem.</span>
        </div>
        <div class="footer-links">
          <a href="https://opensource.greenways.ai/open-source/">A Greenways Open Source Project</a>
          <a href="https://github.com/hara-lang/hara-build/blob/main/LICENSE">Apache-2.0</a>
          <a href="https://github.com/hara-lang/hara-build">Service source</a>
          <a href="https://github.com/hara-lang/hara-specs-registry">Registry source</a>
          <a href="/docs/">Docs</a>
          <a href="/developers">API</a>
          <a href="/registry/index.json">Registry JSON</a>
          <a href="/check">Checker</a>
        </div>
      </footer>
    </Shell>
    <script>
      const loadIdentityClient = () => {
        if (document.querySelector("script[data-hara-identity-client]")) return;
        const testing = location.hostname === "build.testing.hara-lang.org"
          || location.hostname.endsWith(".testing.hara-lang.org");
        const identityOrigin = testing
          ? "https://id.testing.hara-lang.org"
          : "https://id.hara-lang.org";
        const script = document.createElement("script");
        script.src = `${identityOrigin}/identity-client.js`;
        script.defer = true;
        script.dataset.haraIdentityClient = "";
        document.head.append(script);
      };

      document.addEventListener("astro:page-load", loadIdentityClient);
      loadIdentityClient();
    </script>
  </body>
</html>
